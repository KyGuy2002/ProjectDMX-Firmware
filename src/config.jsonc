{
    "input": {
        "source": "sacn"
    },
    "chataigne": {
        "ip": "192.168.1.29",
        "port": 6000
    },
    "dmx_output": {
        "universe": 0
    },
    "audio": {
        "universe": 0,
        // 4 consecutive channels starting here: idle-left, idle-right, effect-left, effect-right.
        // Per channel: 0 = silent, 1-127 = play idle_files/effect_files[value-1] once,
        // 128-255 = loop idle_files/effect_files[value-128].
        // If idle-left and idle-right (or effect-left/right) resolve to the same file+mode,
        // it's played as a single synced decode duplicated to both speakers.
        "start_channel": 20,
        "idle_files": ["soul.mp3", "tonight.mp3", "friends.mp3", "supernova.mp3"],
        "effect_files": ["spark1.mp3", "laser1.mp3"]
    },
    "modules": {
        "slot_a": {
            "type": "fog_machine",
            "universe": 1,
            "start_channel": 4
        },
        "slot_b": {
            "disabled": true
        },
        "slot_c": {
            "type": "neo",
            "ports": [

                // Switched Lights Puzzle
                {
                    "protocol": "sk6812",
                    "color_order": "rgbw",
                    "pixel_count": 6,
                    "universe": 2,
                    "start_channel": 0,
                    "mode": "raw"
                },

                //
                {
                    "disabled": true
                },

                // Bullet Pixels (Equipment)
                {
                    "protocol": "ws2812",
                    "color_order": "rgb",
                    "pixel_count": 80,
                    "universe": 1,
                    "start_channel": 30,
                    "mode": "raw"
                },

                // // Glowing Wire
                // {
                //     "protocol": "ws2812",
                //     "color_order": "grb",
                //     "pixel_count": 80,
                //     "universe": 1,
                //     "start_channel": 0,
                //     "mode": "raw"
                // },
                

                //
                {
                    "disabled": true
                }

                

            ]
        },
        "slot_d": {
            "type": "dimmer",
            "universe": 1,
            "start_channel": 0
        }
    }
}