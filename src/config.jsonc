{
    "input": {
        "source": "sacn"
    },
    "chataigne": {
        "host": "fpp.local",
        "port": 6000
    },
    "dmx_output": {
        "universe": 1
    },
    "audio": {
        "universe": 3,
        "start_channel": 10,
        "bg_files": ["idle-bg-2026.mp3", "overload-bg-2026.mp3"],
        "left_files": ["idle-bones-2026.mp3", "startup-bones-2026.mp3", "overload-bones-2026.mp3", "strike-bones-2026.mp3"],
        "right_files": ["idle-frank-2026.mp3", "startup-frank-2026.mp3", "overload-frank-2026.mp3", "strike-frank-2026.mp3"]
    },
    "modules": {
        "slot_a": {
            "type": "fog",
            "universe": 3,
            "start_channel": 9
        },


        "slot_b": {
            "type": "dimmer",
            "universe": 3,
            "start_channel": 5,
            // Frank Solenoid L, Frank Solenoid R, Hanging Corpse Trigger, Shaking Wires Trigger
            "binary": [true, true, true, true]
        },
        "slot_c": {
            "type": "neo",
            "ports": [

                // Cage Lights (24v alibaba uplights)
                {
                    "protocol": "sk6812",
                    "color_order": "rgbw",
                    "pixel_count": 6,
                    "universe": 2,
                    "start_channel": 1,
                    "mode": "raw"
                },

                // Equipment Bullet Indicators (12v w/ adapter)
                {
                    "protocol": "ws2812",
                    "color_order": "rgb",
                    "pixel_count": 39,
                    "universe": 2,
                    "start_channel": 31,
                    "mode": "raw"
                },

                // Glowing Wire (24v alibaba wire)
                {
                    "protocol": "ws2812",
                    "color_order": "grb",
                    "pixel_count": 240,
                    "universe": 2,
                    "start_channel": 200,
                    "mode": "generator2d"
                },

                // Glowing Wire (24v alibaba wire)
                {
                    "protocol": "ws2812",
                    "color_order": "grb",
                    "pixel_count": 240,
                    "universe": 2,
                    "start_channel": 210,
                    "mode": "generator2d"
                }

                

            ]
        },

        "slot_d": {
            "type": "dimmer",
            "universe": 3,
            "start_channel": 1,
            // CRT Fog, CRT Solenoid, Meltdown Fog, 12v Glowing Wire
            "binary": [true, true, true, false]
        }
    }
}